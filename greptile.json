{
  "$comment": "Enable GitHub native squash auto-merge after required checks and current-head Greptile 5/5 approval. Verify dashboard confidence and repository-scoped auto-approval separately.",
  "strictness": 2,
  "commentTypes": [
    "logic"
  ],
  "statusCheck": true,
  "shouldUpdateDescription": false,
  "hideFooter": true,
  "includeConfidenceScore": true,
  "triggerOnUpdates": true,
  "triggerOnDrafts": false,
  "ignorePatterns": "**/_generated/**\n.next/**\n**/*.min.js\n**/*.min.mjs\n/.claude/settings.json\n/.coderabbit.yaml\n/.githooks/pre-push\n/.repo-standard-source.json\n/AGENTS.md\n/CLAUDE.md\n/apply-ruleset.sh\n/docs/agents/policy.md\n/docs/agents/review-checklist.md\n/docs/halo.md\n/docs/setup.md\n/docs/t3-compatibility.md\n/greptile.json\n/ruleset.json\n/scripts/changed_tests.py\n/scripts/check\n/scripts/commands.py\n/scripts/development.py\n/scripts/halo.py\n/scripts/install-hooks.mjs\n/scripts/lint-shell\n/scripts/new-repo\n/scripts/pre_push.py\n/scripts/repository.py\n/scripts/review\n/scripts/service_setup.py\n/scripts/setup\n/scripts/standard.py\n/scripts/t3_actions.py\n/scripts/test\n/scripts/worktree.py\n/scripts/wt.sh",
  "customContext": {
    "files": [
      {
        "path": "AGENTS.md",
        "description": "Project standards: commands, environments, conventions, what not to touch, definition of done"
      }
    ]
  },
  "autoReview": [
    "open",
    "push",
    "rebase"
  ],
  "labels": [],
  "disabledLabels": [],
  "autoApprove": {
    "enabled": true,
    "riskCeiling": "critical",
    "filters": {
      "includeRepositories": [
        "sshickles/steveshickles_website"
      ]
    }
  }
}
